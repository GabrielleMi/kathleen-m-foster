---
import Icon from "../components/Icon.astro";
import NavItem from "./NavItem.astro";
---

<nav class="bg-black text-white">
    <div class="flex container mx-auto text-xl uppercase gap-8 py-3">
        <ul class="flex-1 flex gap-4">
            <NavItem linkProps={{ title: "Instagram", class: "hover:opacity-50 hover:no-underline fa-brands fa-instagram" }} />
            <NavItem linkProps={{ title: "Patreon", class: "hover:opacity-50 hover:no-underline fa-brands fa-patreon" }} />
        </ul>
        <ul class="flex justify-center gap-8">
            <NavItem href="/">
                Accueil
            </NavItem>
            <NavItem href="/#a-propos">
                L'autrice
            </NavItem>
            <NavItem href="/#contact">
                Discuter
            </NavItem>
        </ul>
        <ul class="flex-1 flex gap-4 justify-end">
            <NavItem linkProps={{ title: "Dark Mode", class: "hover:opacity-50 hover:no-underline" }}>
                <Icon icon="dark_mode" />
            </NavItem>
            <NavItem
                href="/histoires"
                class="block"
                linkProps={{ class: "border hover:bg-white hover:text-black border-white px-3" }}
            >
                Lire
            </NavItem>
        </div>
    </div>
</nav>